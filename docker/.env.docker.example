# Copy to project root .env or merge — BE/worker đọc qua env_file + override trong compose.
# Cổng host = cổng dev hiện tại + 1 (xem docker-compose.yml).

NODE_ENV=development
AGENT_PORT=8890

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_NAME=mini_shop_db
POSTGRES_SSL_MODE=disabled
POSTGRES_DIALECT=postgres

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BROKER=kafka:9092

CLIENT_CORS=http://localhost:2990
API_BASE_URL=http://localhost:8890
FRONTEND_URL_DEV=http://localhost:2990

# JWT / mail / OAuth — điền giá trị thật từ .env local
JWT_SECRET_USER_LOGIN=change_me
JWT_EXPIRE=7d
JWT_SECRET_SHOPOWNER_LOGIN=change_me
JWT_SECRET_COLLABORATOR_LOGIN=change_me
ROOM_SOCKET_ID=change_me

MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false

NEXT_PUBLIC_API_SERVER=http://be:8890
