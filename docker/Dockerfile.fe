FROM node:20-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

COPY web/package.json web/yarn.lock ./
RUN yarn install --frozen-lockfile

COPY web/ ./

ENV NODE_ENV=development
ENV PORT=2990

EXPOSE 2990

CMD ["yarn", "dev", "-p", "2990"]
