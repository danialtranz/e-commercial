# Environment
NODE_ENV=development

# Server Port
AGENT_PORT=8889

# Kafka (Optional — MVP event bus)
KAFKA_BROKER=localhost:9092

# PostgreSQL Database (Development) - REQUIRED
POSTGRES_HOST=pass_your_value_here
POSTGRES_PORT=pass_your_value_here
POSTGRES_USER=pass_your_value_here
POSTGRES_PASSWORD=pass_your_value_here
POSTGRES_NAME=pass_your_value_here
POSTGRES_SSL_MODE=pass_your_value_here
POSTGRES_DIALECT=pass_your_value_here


# JWT Configuration - REQUIRED
JWT_SECRET_USER_LOGIN=pass_your_value_here
JWT_EXPIRE=pass_your_value_here
JWT_SECRET_SHOPOWNER_LOGIN=pass_your_value_here
JWT_SECRET_COLLABORATOR_LOGIN=pass_your_value_here
# Socket Configuration - REQUIRED
ROOM_SOCKET_ID=pass_your_value_here

# CORS Configuration (Optional)
CLIENT_CORS=pass_your_value_here

# Google OAuth2 (Optional)
GOOGLE_CLIENT_ID=pass_your_value_here
GOOGLE_CLIENT_SECRET=pass_your_value_here
GOOGLE_REDIRECT_URI=pass_your_value_here

# Socket Room Names (Optional)
SOCKET_NOTIFICATION_ROOM_NAME=pass_your_value_here

# Frontend URL (Optional)
FRONTEND_URL_DEV=pass_your_value_here
FRONTEND_URL_PROD=pass_your_value_here
VERIFY_EMAIL_SUCCESS_REDIRECT_URL=pass_your_value_here

# Base URL cho link xác minh email (mặc định http://localhost:AGENT_PORT)
API_BASE_URL=pass_your_value_here







MINIO_ENDPOINT=pass_your_value_here
MINIO_PORT=pass_your_value_here


OPENAI_API_KEY=pass_your_value_here
OPENAI_CHAT_MODEL=pass_your_value_here

MAIL_USER=pass_your_value_here
MAIL_PASSWORD=pass_your_value_here
MAIL_SMTP_HOST=pass_your_value_here
MAIL_SMTP_PORT=pass_your_value_here
MAIL_SMTP_SECURE=pass_your_value_here

VERIFY_EMAIL_SUCCESS_REDIRECT_URL=pass_your_value_here
FRONTEND_URL_DEV=pass_your_value_here
