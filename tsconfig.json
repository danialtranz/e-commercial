{
  "compilerOptions": {
    "target": "ES2020", 
    "module": "CommonJS",
    "outDir": "./dist", 
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"] 
    },
    "esModuleInterop": true, 
    "strict": false,
    "skipLibCheck": true 
  },
  "include": ["src/**/*", "agent-init.ts","global.d.ts"],
  "exclude": ["node_modules"] 
}
